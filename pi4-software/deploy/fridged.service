# The fridge data service, under systemd.
#
# Installed to /etc/systemd/system/fridged.service by deploy/install.sh.
# Everything that varies between machines lives in /etc/default/fridged, so
# switching from the simulator to the real board is one line in a config file
# rather than an edit to this unit.

[Unit]
Description=Smart fridge data service (serial link -> SQLite)
# __WORKDIR__, not %h: this is a SYSTEM unit, where %h is root's home regardless
# of User=, so the path would point somewhere that does not exist.
Documentation=file:__WORKDIR__/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__

# Primary group `grafana`, so every file this service creates is group-readable
# and group-writable by Grafana. SQLite CANNOT open a WAL database read-only —
# a reader has to write the -shm wal-index — so Grafana needs write access to
# fridge.db and to the -wal and -shm files beside it.
Group=grafana

# Setting Group= REPLACES the primary group and DROPS every supplementary group
# the login user has. Interactively you are in `dialout` and `video` and things
# just work; here you are not, and they do not.
#
# This was invisible for as long as the service only ran `--port sim` against a
# simulated shelf — neither device was ever opened. The failure it produces is
# also unhelpfully quiet: a bare EACCES on open, a crash, and a five-second
# restart loop that looks like a flaky cable.
#
#   dialout  /dev/ttyACM* — the board.
#   video    /dev/video*, /dev/media*, /dev/dma_heap/* — libcamera needs all
#            three, and dma_heap is the one people forget.
#
# If a fresh image puts any of those in a different group, `install.sh` says so
# rather than letting it fail at boot.
SupplementaryGroups=dialout video

# 0002 keeps the group-write bit on files this service creates. fridged also
# sets this itself, deliberately duplicated: the daemon should not depend on
# being launched correctly, and the unit should not depend on the daemon
# remembering.
UMask=0002

EnvironmentFile=/etc/default/fridged
WorkingDirectory=__WORKDIR__
ExecStart=/usr/bin/python3 -m fridged $FRIDGED_ARGS

# fridged installs a SIGTERM handler that flushes the pending write batch before
# exiting. Without it, every restart would silently discard up to
# FLUSH_INTERVAL_S of rows and punch a small invisible hole in the history.
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=always
RestartSec=5

# Journal only. The service logs through Python's logging module, and a second
# copy in a file nobody rotates is how a Pi fills its SD card.
StandardOutput=journal
StandardError=journal

# Modest hardening. Not a security boundary — this is a LAN appliance — but
# these cost nothing and narrow the blast radius of a mistake.
#
# Checked against the camera rather than assumed, because a sandbox that breaks
# libcamera would show up as an outage rather than an error message:
#
#   PrivateTmp      /tmp and /var/tmp only. libcamera's buffers are in /dev/shm
#                   and its IPA sockets in /run, so neither is affected.
#   ProtectSystem   /usr, /boot and /etc read-only. libcamera only READS its
#                   tuning file from /usr/share/libcamera/ipa/rpi/vc4/.
#
# DELIBERATELY ABSENT: ProtectHome. It would break everything — the checkout,
# picapture.conf and the picapture binary all live under the login user's home,
# and picapture is started with its working directory there so it finds its
# tuning. Adding ProtectHome=true silently drops it back to compiled-in defaults
# that nobody measured. Same for PrivateDevices=true, which would hide the very
# devices the SupplementaryGroups above exist to reach.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/fridge

[Install]
WantedBy=multi-user.target
