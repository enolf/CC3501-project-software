    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperature — all three zones",
      "description": "Bucketed to 60 s with $__unixEpochGroupSeconds, the only grouping macro this plugin provides. Readings arrive every 30 s, so a bucket averages a pair. Nulls are NOT spanned: the 30 s gap after the board reboots is real and should look like a gap.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "fridge-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fridge-sqlite"
          },
          "queryText": "SELECT $__unixEpochGroupSeconds(\"ts\", 60) AS ts,\n       AVG(CASE WHEN zone = 'freezer'       THEN celsius END) AS \"Freezer\",\n       AVG(CASE WHEN zone = 'fridge_top'    THEN celsius END) AS \"Top shelf\",\n       AVG(CASE WHEN zone = 'fridge_bottom' THEN celsius END) AS \"Bottom shelf\"\nFROM temperature\nWHERE ts BETWEEN ${__from:date:seconds} AND ${__to:date:seconds}\nGROUP BY 1\nORDER BY 1",
          "rawQueryText": "SELECT $__unixEpochGroupSeconds(\"ts\", 60) AS ts,\n       AVG(CASE WHEN zone = 'freezer'       THEN celsius END) AS \"Freezer\",\n       AVG(CASE WHEN zone = 'fridge_top'    THEN celsius END) AS \"Top shelf\",\n       AVG(CASE WHEN zone = 'fridge_bottom' THEN celsius END) AS \"Bottom shelf\"\nFROM temperature\nWHERE ts BETWEEN ${__from:date:seconds} AND ${__to:date:seconds}\nGROUP BY 1\nORDER BY 1",
          "timeColumns": [
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
