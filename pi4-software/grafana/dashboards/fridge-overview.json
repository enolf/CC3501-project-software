    "fridge"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Freezer",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "fridge-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fridge-sqlite"
          },
          "queryText": "SELECT ts, celsius\nFROM temperature\nWHERE zone = 'freezer'\n  AND ts BETWEEN ${__from:date:seconds} AND ${__to:date:seconds}\nORDER BY ts",
          "rawQueryText": "SELECT ts, celsius\nFROM temperature\nWHERE zone = 'freezer'\n  AND ts BETWEEN ${__from:date:seconds} AND ${__to:date:seconds}\nORDER BY ts",
          "timeColumns": [
