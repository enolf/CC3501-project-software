        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fridge-sqlite"
          },
          "queryText": "SELECT COALESCE(s.zone_label, '(not named yet)') AS \"Zone\",\n       s.rom_code AS \"ROM code\",\n       ROUND((SELECT value FROM measurement\n              WHERE metric = 'temp.rom.' || s.rom_code\n              ORDER BY ts DESC LIMIT 1), 2) AS \"Latest C\",\n       DATETIME((SELECT MAX(ts) FROM measurement\n                 WHERE metric = 'temp.rom.' || s.rom_code),\n                'unixepoch', 'localtime') AS \"Last reading\"\nFROM sensor s\nORDER BY (s.zone_label IS NULL) DESC, s.zone_label",
